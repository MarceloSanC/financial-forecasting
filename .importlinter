# =============================================================================
# .importlinter — contratos de arquitetura (fitness function)
# =============================================================================
# Espelha docs/LAYOUT.md §3/§6 (FONTE DA VERDADE). Se LAYOUT e este arquivo
# divergirem, LAYOUT vence e ESTE arquivo é corrigido (concept 1.3 I6/D4).
#
# Rodado por `uv run lint-imports` (exit != 0 em violação), plugado em
# `make check` e no CI (ci.yml). Prova-se por quebra intencional revertida:
# `import pandas` em shared/domain deixa o build vermelho (DoD central, A3).
#
# Camadas-alvo refletem a estrutura modular REAL (finding F2 da 1.1): o
# esqueleto excedente do template (shared.infrastructure.{clock,http,...},
# shared.application.ports.out.*) e o `features/` ainda vazio NÃO podem
# reprovar — daí `exhaustive = False` e camadas opcionais entre parênteses.
# ADR: docs/adr/1_3_0001-import-linter-as-architecture-fitness-function.md
# =============================================================================

[importlinter]
root_package = financial_forecasting
# OBRIGATÓRIO: o contrato domain-purity declara forbidden_modules EXTERNOS
# (pandas/pyarrow/torch/numpy/pydantic/sqlalchemy/fastapi); sem esta flag o
# import-linter ABORTA ("must have include_external_packages=True when there
# are external forbidden modules"). A proteção contra ignore_imports morto é
# governada por unmatched_ignore_imports_alerting (ver contrato shared-no-features).
include_external_packages = True
# Imports sob `if TYPE_CHECKING:` NÃO são dependências de runtime — existem só
# para o type checker (mypy) e são apagados em execução. O domínio pode tipar
# um parâmetro `hasher: Hasher` (port em application) via TYPE_CHECKING sem
# criar acoplamento de runtime: o Protocol é satisfeito por duck-typing. Sem
# esta flag, grimp contaria o import type-only como dependência domain->
# application e reprovaria hexagonal-layers falsamente. Espelha LAYOUT §3 (a
# direção de RUNTIME aponta para dentro) e a nota de ordenação do technical 1.4
# (ADR 1.4.0001 / Stage 1.4 [decision]). Mantém a pureza: domain-purity e
# inward-only seguem reprovando imports REAIS (runtime) de fora.
exclude_type_checking_imports = True

# -----------------------------------------------------------------------------
# Contrato 1 — hexagonal-layers (type = layers)
# LAYOUT §3: "as dependências apontam para dentro" (adapters > application >
# domain). Camadas SUPERIORES podem importar as INFERIORES; o inverso quebra.
# Modelado por container `shared`; camadas opcionais `(...)` toleram ausência
# no esqueleto inerte (F2/I7/C5). Cada feature vira container ao ganhar layers.
# -----------------------------------------------------------------------------
[importlinter:contract:hexagonal-layers]
name = Hexagonal layers (adapters > application > domain) por container
type = layers
layers =
    (adapters)
    application
    domain
containers =
    financial_forecasting.shared
    financial_forecasting.features.market_data
    # Stage 3.1 (concept 3.1 D1 / ADR 2.2.0001 / LAYOUT §3): cada NOVA feature com
    # domain/application vira container ao ganhar layers. feature_engineering tem só
    # domain/application/adapters/out nesta Stage (sem adapters/in/ports/in) — daí
    # `(adapters)` opcional e `exhaustive = False` continuam cobrindo a ausência.
    financial_forecasting.features.feature_engineering
    # Stage 4.1 (concept 4.1 I8/D4 / ADR 4.1.0001 / LAYOUT §3): novo BC analytics_store
    # entra como container layered. Nesta Stage tem só domain (VOs) e adapters/out/parquet
    # (schemas pandera); a camada application existe vazia (placeholder p/ 4.2/4.3) — daí
    # `(adapters)` opcional + `exhaustive = False` toleram as camadas ainda esparsas.
    financial_forecasting.features.analytics_store
    # Stage 5.1 (concept 5.1 §8 / LAYOUT §3): novo BC modeling entra como container
    # layered. Nesta Stage tem só domain (services + value_objects) e application vazia
    # (placeholder p/ 5.2+) — daí `(adapters)` opcional + `exhaustive = False` toleram a
    # ausência de adapters e a application ainda vazia.
    financial_forecasting.features.modeling
exhaustive = False

# -----------------------------------------------------------------------------
# Contrato 2 — domain-purity (type = forbidden) — DoD CENTRAL
# LAYOUT §3 (linha 104): domain importa só stdlib + domain. Proíbe libs de
# dados/ML (pandas/pyarrow/torch) e de framework (pydantic/sqlalchemy/fastapi).
# É a regra cuja ausência apodreceu o repo antigo (23/36 arquivos de domínio
# importavam pandas/numpy/torch). `numpy` incluído por defesa em profundidade.
# Stage 2.2 (finding F2.2 / concept 2.2 D1): estende a `features.market_data.domain`
# — o `type=layers` prova só a DIREÇÃO (domain não importa application/adapters),
# NÃO a pureza de lib externa do domain de feature. Sem esta linha, `import pandas`
# no domain de market_data passaria silenciosamente (verificado por quebra intencional
# que NÃO reprovava). Cada NOVA feature com domain entra aqui (mesma postura do
# `shared.domain`). Concept 2.2 A8.
# -----------------------------------------------------------------------------
[importlinter:contract:domain-purity]
name = Domain puro — sem pandas/pyarrow/torch/pydantic/sqlalchemy/fastapi
type = forbidden
source_modules =
    financial_forecasting.shared.domain
    financial_forecasting.features.market_data.domain
    # Stage 3.1 (concept 3.1 D1/I1 / LAYOUT §3): o domain de feature_engineering
    # (IndicatorSpec + registry + hash) é stdlib-only; `import pandas`/`pandas_ta_classic`
    # aqui REPROVA — provado por quebra intencional revertida (Task 08 / A9). Cada NOVA
    # feature com domain entra aqui (mesma postura do shared.domain / market_data.domain).
    financial_forecasting.features.feature_engineering.domain
    # Stage 4.1 (concept 4.1 I1/D4 / ADR 4.1.0001): o domain de analytics_store
    # (RunRecord + PredictionRow, VOs frozen) é stdlib-only; `import pandas`/`pandera`
    # aqui REPROVA — provado por quebra intencional revertida (Task 09 / A9). Corrige na
    # origem o apodrecimento do old (multi_horizon_prediction_persister.py importava pandas
    # em arquivo de domínio). Cada NOVA feature com domain entra aqui.
    financial_forecasting.features.analytics_store.domain
    # Stage 5.1 (concept 5.1 §5 I10 / ADR 5.1.0001-0003): o domain de modeling
    # (WalkForwardSplitter + FoldSplit/ScopeSpec + dedup) é stdlib-only; `import pandas`/
    # `numpy`/`torch` aqui REPROVA — provado por quebra intencional revertida (Task 01) e
    # pelo caso `domain-purity:modeling-domain-imports-pandas` do teste de arquitetura.
    # A única referência a application é o tipo `Hasher` sob TYPE_CHECKING (não runtime).
    financial_forecasting.features.modeling.domain
forbidden_modules =
    pandas
    pyarrow
    torch
    numpy
    pydantic
    sqlalchemy
    fastapi
allow_indirect_imports = False

# -----------------------------------------------------------------------------
# Contrato 3 — inward-only (type = forbidden)
# LAYOUT §3 (linhas 94/110): a dependência aponta para DENTRO.
#   - application NÃO importa adapters nem shared.infrastructure
#   - domain NÃO importa application/adapters/shared.infrastructure
# A exceção composition_root (shared.infrastructure.http.app -> composition_root
# -> features.*.adapters) é tratada por ignore_imports abaixo (LAYOUT §6).
# -----------------------------------------------------------------------------
[importlinter:contract:inward-only]
name = Direção outside-in — application/domain não importam para fora
type = forbidden
source_modules =
    financial_forecasting.shared.application
    financial_forecasting.shared.domain
forbidden_modules =
    financial_forecasting.shared.infrastructure

# -----------------------------------------------------------------------------
# Contrato 4 — shared-no-features (type = forbidden)
# LAYOUT §7 (linha 244): "Shared não importa de features". O fluxo é sempre
# features -> shared, nunca o contrário. Única exceção: o caminho INDIRETO do
# composition_root (shared.infrastructure.http.app -> composition_root ->
# features.*.adapters), declarado em ignore_imports (LAYOUT §6, linhas 222-229).
# -----------------------------------------------------------------------------
[importlinter:contract:shared-no-features]
name = Shared não importa de features (exceto fronteira composition_root)
type = forbidden
source_modules =
    financial_forecasting.shared
forbidden_modules =
    financial_forecasting.features
ignore_imports =
    financial_forecasting.shared.infrastructure.http.app -> financial_forecasting.composition_root
    financial_forecasting.composition_root -> financial_forecasting.features.**
# `features/` ainda está vazio: o leg `composition_root -> features.**` da
# fronteira só passa a casar quando a 1ª feature ganhar adapter wireado. Sem
# `none`, o ignore não-casado vira alerta/erro hoje (F2). A presença do caminho
# verbatim (LAYOUT §6, 222-229) documenta a exceção desde já; reentra como erro
# quando o caminho existir e quisermos detectar exceção morta.
unmatched_ignore_imports_alerting = none

# -----------------------------------------------------------------------------
# Contrato 5 — tracker-no-mlflow-leak (type = forbidden) — Stage 1.5 (I4)
# LAYOUT §3: a `application` (e o `domain`) nunca importam libs externas — elas
# vivem só em adapters/infrastructure. Esta é a extensão a `mlflow` do mesmo
# princípio que `domain-purity` aplica a pandas/pyarrow/torch: o port-out
# `ExperimentTracker` (Protocol) troca só primitivos/Mapping; o `mlflow` vive
# APENAS no adapter `shared/adapters/out/mlflow/`. `domain` entra por defesa em
# profundidade (já é stdlib-only, mas blinda contra import futuro). ADR 1.5.0002.
# -----------------------------------------------------------------------------
[importlinter:contract:tracker-no-mlflow-leak]
name = Application/domain não importam mlflow (só o adapter)
type = forbidden
source_modules =
    financial_forecasting.shared.application
    financial_forecasting.shared.domain
forbidden_modules =
    mlflow
allow_indirect_imports = False

# -----------------------------------------------------------------------------
# Contrato 6 — store-no-storage-leak (type = forbidden) — Stage 2.1 (I4)
# LAYOUT §3: a `application` (e o `domain`) nunca importam libs de dados — elas
# vivem só em adapters. Mesma postura que `domain-purity` aplica a
# pandas/pyarrow/torch e que `tracker-no-mlflow-leak` aplica a `mlflow`: o
# port-out `MedallionStore` (Protocol) troca só `collections.abc`/primitivos; as
# libs de storage `pandas`/`pyarrow`/`duckdb`/`pandera` vivem APENAS no adapter
# `shared/adapters/out/parquet/`. Novidade vs `domain-purity`: este contrato
# cobre a camada `application` (não coberta hoje) e adiciona `duckdb`/`pandera`
# (não listados em `domain-purity`). `domain` entra por defesa em profundidade
# (já stdlib-only, mas blinda contra import futuro). Concept 2.1 I4 / ADR 2.1.0002.
# -----------------------------------------------------------------------------
[importlinter:contract:store-no-storage-leak]
name = Application/domain não importam pandas/pyarrow/duckdb/pandera (só adapters)
type = forbidden
source_modules =
    financial_forecasting.shared.application
    financial_forecasting.shared.domain
    financial_forecasting.features.market_data.application
    financial_forecasting.features.market_data.domain
    # Stage 3.1 (concept 3.1 D1/I5/I12): estende a
    # `features.feature_engineering.{application,domain}`. O port-out IndicatorCalculator
    # (Protocol) troca só `collections.abc`/primitivos + a entity Candle; pandas e
    # pandas_ta_classic vivem APENAS no adapter `adapters/out/pandas_ta/`. `pandas_ta_classic`
    # entra em forbidden_modules abaixo (não coberto por domain-purity) para fechar o I12.
    financial_forecasting.features.feature_engineering.application
    financial_forecasting.features.feature_engineering.domain
    # Stage 4.1 (concept 4.1 I2/D4 / ADR 4.1.0001 e 2.1.0002): estende a
    # `features.analytics_store.{application,domain}`. Os schemas `pandera` silver vivem
    # SÓ no adapter `adapters/out/parquet/schemas/`; os VOs de domínio (RunRecord/
    # PredictionRow) e a futura application (4.2/4.3) NUNCA importam pandas/pandera. A
    # camada application existe vazia nesta Stage (defesa em profundidade — source sem
    # imports não reprova). Provado por quebra intencional revertida (Task 09 / A9).
    financial_forecasting.features.analytics_store.application
    financial_forecasting.features.analytics_store.domain
    # Stage 5.2 (concept 5.2 §5 I8; finding da 5.1 §7): estende a
    # `features.modeling.{application,domain}`. O use case `RunBaselines` lê o dataset
    # pelo port `MedallionStore` (par read-only `("processed", "dataset_tft")` — D3) e
    # troca só primitivos/`collections.abc`; pandas/pyarrow vivem APENAS nos adapters.
    # `domain` entra por defesa em profundidade (já stdlib-only via domain-purity).
    # Provado por quebra intencional revertida (Task 08 / A9).
    financial_forecasting.features.modeling.application
    financial_forecasting.features.modeling.domain
forbidden_modules =
    pandas
    pyarrow
    duckdb
    pandera
    # Stage 3.1 (I12): lib de indicadores confinada ao adapter; vazar p/ application/domain reprova.
    pandas_ta_classic
allow_indirect_imports = False
# Stage 2.2 (concept 2.2 D1/I8): estende a `features.market_data.{application,domain}`.
# O use case `IngestCandles` produz `Row` com float/int Python e delega a coerção de
# dtype ao adapter de escrita (ParquetMedallionStore) — NUNCA importa pandas/pyarrow;
# o adapter `ParquetRawCandleFetcher` é a ÚNICA porta de entrada dessas libs no BC.
# Cada NOVA feature com application/domain que consome o MedallionStore entra aqui.

# -----------------------------------------------------------------------------
# Contrato 7 — calendar-no-exchange-calendars-leak (type = forbidden) — Stage 2.4 (I3)
# LAYOUT §3: a `application` (e o `domain`) nunca importam libs externas — elas
# vivem só em adapters. Mesma postura que `domain-purity`/`store-no-storage-leak`/
# `tracker-no-mlflow-leak`: o port-out `ExchangeCalendarProvider` (Protocol) troca
# só `date`/o VO de domínio `TradingSessions`; a lib `exchange_calendars` (que
# arrasta pandas/numpy) vive APENAS no adapter `shared/adapters/out/calendar/`. O
# serviço de domínio `TradingCalendar` opera sobre o VO injetado e NUNCA importa a
# lib nem o port — a direção inward-only fica intacta (ADR 2.4.0001). `domain`
# entra por defesa em profundidade (já stdlib-only, blinda contra import futuro).
# -----------------------------------------------------------------------------
[importlinter:contract:calendar-no-exchange-calendars-leak]
name = Application/domain não importam exchange_calendars (só o adapter)
type = forbidden
source_modules =
    financial_forecasting.shared.application
    financial_forecasting.shared.domain
forbidden_modules =
    exchange_calendars
allow_indirect_imports = False

# -----------------------------------------------------------------------------
# Contrato 8 — sentiment-no-ml-leak (type = forbidden) — Stage 3.2 (I5/D2)
# LAYOUT §3: a `application` (e o `domain`) nunca importam libs de ML — elas vivem
# só em adapters. Mesma postura que `domain-purity`/`store-no-storage-leak`/
# `calendar-no-exchange-calendars-leak`: o port-out `SentimentModel` (Protocol) troca
# só `Sequence[float]` + a entity `NewsArticle`; `torch`/`transformers` vivem APENAS
# no adapter `features/feature_engineering/adapters/out/finbert/`, com import LAZY
# (extra opcional `sentiment`, fora do `dev`). `domain` entra por defesa em
# profundidade (já stdlib-only, blinda contra import futuro). Novidade vs
# `domain-purity` (que já lista `torch`): este contrato cobre a camada `application`
# do BC feature_engineering (não coberta por domain-purity) e adiciona `transformers`.
# Provado por quebra intencional revertida (Task 07/A9). Concept 3.2 I5/D2 / ADR 3.2.0002.
# -----------------------------------------------------------------------------
[importlinter:contract:sentiment-no-ml-leak]
name = Application/domain não importam torch/transformers (só o adapter finbert)
type = forbidden
source_modules =
    financial_forecasting.features.feature_engineering.application
    financial_forecasting.features.feature_engineering.domain
forbidden_modules =
    torch
    transformers
allow_indirect_imports = False

# -----------------------------------------------------------------------------
# Contrato 9 — modeling-no-statsforecast-leak (type = forbidden) — Stage 5.2 (I8)
# LAYOUT §3: a `application` (e o `domain`) nunca importam libs externas — elas
# vivem só em adapters. Mesma postura que `tracker-no-mlflow-leak`/
# `sentiment-no-ml-leak`: o port-out `BaselineForecaster` (Protocol) troca só
# primitivos/`collections.abc` + o VO `BaselineSpec`; `statsforecast` (e o
# `numpy` que ela usa) vive APENAS no adapter
# `features/modeling/adapters/out/statsforecast/` (ADR 5.2.0001 — o fit do
# AR(1) é o ÚNICO uso; toda a emissão é fórmula de domínio stdlib-only).
# Novidade vs `domain-purity` (que já lista `numpy`): este contrato cobre a
# camada `application` do BC modeling (não coberta por domain-purity) e adiciona
# `statsforecast`/`numba`. `numba` entra por defesa em profundidade (a
# statsforecast 2.x resolvida usa `coreforecast`, mas a família 1.x arrastava
# numba — blinda contra downgrade/import futuro). `domain` idem (já stdlib-only).
# Provado por quebra intencional revertida (Task 08 / A9). Concept 5.2 I8/§8.
# -----------------------------------------------------------------------------
[importlinter:contract:modeling-no-statsforecast-leak]
name = Application/domain não importam statsforecast/numba/numpy (só o adapter)
type = forbidden
source_modules =
    financial_forecasting.features.modeling.application
    financial_forecasting.features.modeling.domain
forbidden_modules =
    statsforecast
    numba
    numpy
allow_indirect_imports = False

# Contrato 10 — modeling-no-lightgbm-leak (type = forbidden) — Stage 5.3 (A9)
# Mesma postura do contrato 9 para a lib do GBM quantílico: o port-out
# `QuantileModelTrainer` (Protocol) troca só primitivos/`collections.abc`;
# `lightgbm` vive APENAS no adapter features/modeling/adapters/out/lightgbm/
# (concept 5.3 §8). Single-purpose: `numpy` já é proibido nessas camadas pelo
# contrato 9 — aqui entra só `lightgbm`.
[importlinter:contract:modeling-no-lightgbm-leak]
name = Application/domain não importam lightgbm (só o adapter)
type = forbidden
source_modules =
    financial_forecasting.features.modeling.application
    financial_forecasting.features.modeling.domain
forbidden_modules =
    lightgbm
allow_indirect_imports = False
