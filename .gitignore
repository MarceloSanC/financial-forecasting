# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribuição e empacotamento
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ---------------------------------------------------------------------------
# Ambientes virtuais
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Variáveis de ambiente — NUNCA commitar .env com segredos reais
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Ferramentas de qualidade
# ---------------------------------------------------------------------------
.ruff_cache/
.mypy_cache/
.pytest_cache/
.import_linter_cache/

# ---------------------------------------------------------------------------
# Cobertura de testes
# ---------------------------------------------------------------------------
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# uv
# ---------------------------------------------------------------------------
# uv.lock É versionado por padrão neste template (projetos derivados são
# aplicações FastAPI). O `scripts/init-project.py` roda `make setup` antes
# do primeiro commit, então o lockfile entra no commit inicial. Se em
# algum momento o projeto virar biblioteca publicada em PyPI, mover a
# linha abaixo para ativa. Ver CONVENTIONS.md §"Política de uv.lock".
# uv.lock

# ---------------------------------------------------------------------------
# Certificados de CA locais (raiz de antivirus/proxy que intercepta TLS)
# ---------------------------------------------------------------------------
# Especificos da maquina — o Avast, por exemplo, gera uma raiz por instalacao.
# O postCreateCommand do devcontainer instala o que estiver aqui no trust store
# do container (update-ca-certificates). Nunca versionar: nao serve para outra
# maquina e e uma raiz de MITM.
.devcontainer/certs/

# ---------------------------------------------------------------------------
# IDEs e editores
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Sistema operacional
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Alembic — não versionar migrations geradas automaticamente de ambientes locais
# ---------------------------------------------------------------------------
# migrations/versions/*.py  # descomente se preferir não versionar migrations

# ---------------------------------------------------------------------------
# Dados (medalhão) — nunca versionar datasets/artefatos pesados
# ---------------------------------------------------------------------------
# Convenção de storage definida na Stage 2.1 (MedallionStore). Dados de
# bronze/silver/gold, raw, processed e modelos ficam fora do git.
data/

# ---------------------------------------------------------------------------
# MLflow — tracking local (backend SQLite + artefatos), Stage 1.5 / ADR 1.5.0001
# ---------------------------------------------------------------------------
# `Settings.mlflow_tracking_uri` default `sqlite:///mlruns.db` cria `mlruns.db`
# na worktree; o mlflow ainda materializa artefatos em `./mlruns/` (artifact root
# default). Nenhum dos dois é versionado — tracking é local e reconstruível.
mlruns.db
mlruns/

# ---------------------------------------------------------------------------
# Logs e arquivos temporários
# ---------------------------------------------------------------------------
*.log
*.tmp
tree.txt

# Saída do CSVLogger que o `Trainer` interno do `predict` cria (Stage 5.4).
# O adapter passa `logger=False`, mas qualquer uso direto da lib recria isto.
lightning_logs/
